    "A focus timer and to-do list that live in your MacBook's notch.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um timer de foco e uma lista de tarefas que moram no notch do seu MacBook."
          }
        }
      }
    },
    "A line around the notch fills up as the block runs": {
