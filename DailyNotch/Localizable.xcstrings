    "DailyNotch only reads your events and never changes them.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DailyNotch só lê seus eventos e nunca os altera."
          }
        }
      }
    },
    "DailyNotch only reads your events to list them under the day's tasks in the Tasks window. It never changes them, and they never leave your Mac.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DailyNotch só lê seus eventos para listá-los abaixo das tarefas do dia na janela Tarefas. Ele nunca os altera, e eles nunca saem do seu Mac."
          }
        }
      }
    },
